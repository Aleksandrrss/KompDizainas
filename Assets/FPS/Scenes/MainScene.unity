  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "Sveikas, a\u0161 esu ponas Dronas. Robotai nori i\u0161bandyti tave simuliacijoje.\nPasiimk
    \u0161\u012F rakt\u0105 ir eik \u012F simuliacijos kambar\u012F kair\u0117je.
    B\u016Bk atidus \u2013 robotai m\u0117gsta juokauti\u2026 kartais labai skaud\u017Eiai.\n\nJeigu
    nenori rizikuoti, gali pasirinkti ir kit\u0105 keli\u0105. De\u0161in\u0117je
    tav\u0119s laukia ramesnis mar\u0161rutas, bet jis pareikalaus daugiau m\u0105stymo."
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 2e498d1c8094910479dc3e1b768306a4, type: 2}
